+
+// startCommandLoop consumes unsolicited control messages after authentication.
+// CS2 has a bounded command queue; leaving it unread eventually closes the
+// entire connection, including video. The existing connection owner retains
+// Close ownership: closing the connection unblocks ReadCommand and ends this
+// goroutine. The completion signal is useful for checking that lifecycle.
+func (c *Client) startCommandLoop() <-chan struct{} {
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		for {
+			if _, _, err := c.Conn.ReadCommand(); err != nil {
+				return
+			}
+		}
+	}()
+	return done
 }
 
